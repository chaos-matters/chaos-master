---
import { LAUNCH_ICON } from '../icons'

const arcadeUrl = 'https://lumenapeiron.com/arcade'
const docsUrl =
  'https://github.com/chaos-matters/chaos-master/blob/main/docs/webmcp.md'

// The one number that has to stay true: packages/app/src/webmcp/tools/index.ts.
const TOOL_COUNT = 33

// Inline SVG icons, matching Features.astro. These three are the app's own mode
// icons (packages/app/src/icons/{book,film,swords,robot}.svg) so the cards here
// and the hub cards in the editor are the same drawings.
const icons = {
  book: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6.5C10.5 5 8 4.5 4 4.5v13c4 0 6.5.5 8 2 1.5-1.5 4-2 8-2v-13c-4 0-6.5.5-8 2z"/><path d="M12 6.5v11"/></svg>`,
  film: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 4v16M17 4v16M3 9h4M3 15h4M17 9h4M17 15h4"/></svg>`,
  swords: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 17.5 3 6V3h3l11.5 11.5"/><path d="M13 19l6-6M16 16l4 4M19 21l2-2"/><path d="M9.5 6.5 21 18v3h-3L6.5 9.5"/><path d="M5 14l-2 2M8 17l-2 2"/></svg>`,
  robot: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="8" width="16" height="12" rx="2"/><circle cx="9" cy="14" r="1.25"/><circle cx="15" cy="14" r="1.25"/><path d="M12 8V4M9 4h6M2 13h2M20 13h2"/></svg>`,
}

const modes = [
  {
    icon: 'book',
    name: 'Teach',
    tag: 'AI drives',
    body: 'Pick one of seven topics, from variations and affine transforms to sonification. The AI builds a worked example on the flame you already have open, says one sentence before each step, and the whole take replays as a captioned lesson.',
  },
  {
    icon: 'film',
    name: 'Cinema',
    tag: 'AI drives',
    body: 'Describe the move in a sentence, or press Small and slow, Big and cinematic, or Surprise me. The AI reads what can be keyframed, writes the tracks, and the animation lands as one undoable step that plays at once. Not right? Undo, say what to change, ask again.',
  },
  {
    icon: 'swords',
    name: 'Duel',
    tag: 'You + AI',
    body: "You and the AI edit your own flames side by side against one clock. The AI gets its own seat with its own history; your half stays yours, keyboard and all. It cannot stop the clock — that is the pressure. Both takes are saved and a card names the winner.",
  },
]
---

<section id="arcade" class="wrap">
  <p class="kicker">Lumen Arcade</p>
  <h2>Hand the controls to an AI.</h2>
  <p class="lede">
    The Arcade opens the editor to any agent in your browser as {TOOL_COUNT} WebMCP
    tools on <code>document.modelContext</code>. Every write goes through the
    same validated command bus a click uses — undoable, recorded, replayable — so
    you watch the agent work on your own flame and keep everything it makes.
  </p>

  <div class="modes">
    {
      modes.map((m) => (
        <article class="mode">
          <div class="mode-top">
            <span class="mode-icon" set:html={icons[m.icon]} />
            <span class="mode-tag">{m.tag}</span>
          </div>
          <h3>{m.name}</h3>
          <p>{m.body}</p>
        </article>
      ))
    }
  </div>

  <div class="run">
    <span class="run-icon" set:html={icons.robot} />
    <p>
      While the AI drives, the editor is locked behind a shield: the banner
      counts steps against the budget and the clock, the rail lists every command
      and sentence as it lands, and your shortcuts are off. Stop — or Escape
      twice — hands the controls back and still saves the take. A Duel locks only
      the AI's seat, so your half keeps its keyboard while the clock runs.
    </p>
  </div>

  <div class="arcade-cta">
    <a class="btn btn-primary" href={arcadeUrl}
      >Open Lumen Arcade<span class="btn-ico" set:html={LAUNCH_ICON} /></a
    >
    <a class="btn btn-ghost" href={docsUrl}>How it works</a>
  </div>

  <p class="caveat">
    WebMCP is early. It needs Chrome 149 or newer with <code
      >chrome://flags/#enable-webmcp-testing</code
    > switched on, plus WebGPU to render. In any other browser the Arcade still opens
    and the prompt cards still copy, but the status pill will read "WebMCP not detected
    in this browser" and no agent can reach the tools.
  </p>
</section>

<style>
  .modes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-top: 56px;
  }
  .mode {
    padding: 28px;
    border-radius: 16px;
    background: var(--neutral-950);
    border: 1px solid rgba(255, 255, 255, 0.07);
    transition:
      transform 0.3s ease,
      border-color 0.3s ease;
  }
  .mode:hover {
    transform: translateY(-3px);
    border-color: rgba(var(--ember-rgb), 0.35);
  }
  .mode-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
  }
  .mode-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    color: var(--ember);
    background: rgba(var(--ember-rgb), 0.1);
    border: 1px solid rgba(var(--ember-rgb), 0.22);
  }
  .mode-icon :global(svg) {
    width: 21px;
    height: 21px;
  }
  .mode-tag {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--neutral-400);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--round);
    padding: 4px 10px;
    white-space: nowrap;
  }
  .mode h3 {
    margin: 0 0 10px;
    font-size: 1.16rem;
  }
  .mode p {
    margin: 0;
    color: var(--neutral-400);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* The safety story. Dashed, because it describes a boundary rather than a
     feature — same visual grammar as the "On the horizon" cards. */
  .run {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-top: 22px;
    padding: 20px 22px;
    border: 1px dashed rgba(255, 255, 255, 0.14);
    border-radius: 14px;
  }
  .run-icon {
    display: inline-flex;
    flex-shrink: 0;
    color: var(--ember);
    margin-top: 1px;
  }
  .run-icon :global(svg) {
    width: 22px;
    height: 22px;
  }
  .run p {
    margin: 0;
    color: var(--neutral-400);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .arcade-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px;
  }
  .caveat {
    margin: 22px 0 0;
    max-width: 70ch;
    color: var(--neutral-400);
    font-size: 0.86rem;
    line-height: 1.65;
  }
  .caveat code,
  .lede code {
    font-family: var(--mono);
    font-size: 0.92em;
    color: var(--neutral-300);
    background: rgba(255, 255, 255, 0.06);
    border-radius: 5px;
    padding: 1px 6px;
  }

  @media (max-width: 900px) {
    .modes {
      grid-template-columns: 1fr;
    }
  }
</style>
