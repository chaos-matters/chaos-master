---
import '../styles/global.css'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import PreviewModeNotice from '../components/PreviewModeNotice.tsx'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Lumen Apeiron — WebGPU IFS Flame Generator',
  description = 'Lumen Apeiron — The Chaos Master: high-performance, real-time IFS fractal flame generation in the browser, powered by WebGPU. For artists and explorers.',
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site).href
// Landscape 1200x630 social card (1.91:1) — renders correctly in link previews,
// unlike the square hero-flame.jpg it replaced.
const ogImage = new URL('/og-cover.jpg', Astro.site).href

// Dev log piping: when PUBLIC_REMOTE_LOG=true (set in .env.local), mirror the
// device's console + uncaught errors to the dev-server terminal via /__client-log
// (see remoteLogPlugin in astro.config). For debugging phones/tablets that have
// no usable console. Off by default; never active in a production build.
const remoteLog =
  import.meta.env.DEV && import.meta.env.PUBLIC_REMOTE_LOG === 'true'
const gaId = import.meta.env.PUBLIC_GA_ID
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      gaId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', gaId, { send_page_view: true });
          </script>
        </>
      )
    }
    <!-- Mark JS available so reveal-on-scroll only hides content when it can be
         animated back in (no-JS shows everything). Inline + synchronous so it
         runs before first paint. -->
    <script is:inline>document.documentElement.classList.add('js')</script>
    {
      remoteLog && (
        <script is:inline>
          {`(function () {
            var ENDPOINT = '/__client-log';
            function ser(a) {
              try {
                if (a instanceof Error) return a.name + ': ' + a.message + ' | ' + (a.stack || '');
                if (typeof a === 'string') return a;
                return JSON.stringify(a);
              } catch (e) { return String(a); }
            }
            function send(level, args) {
              try {
                var payload = JSON.stringify({ level: level, args: [].map.call(args, ser) });
                var ok = navigator.sendBeacon && navigator.sendBeacon(ENDPOINT, payload);
                if (!ok) fetch(ENDPOINT, { method: 'POST', body: payload, keepalive: true }).catch(function () {});
              } catch (e) {}
            }
            ['log', 'info', 'warn', 'error'].forEach(function (lvl) {
              var orig = console[lvl] ? console[lvl].bind(console) : function () {};
              console[lvl] = function () { orig.apply(console, arguments); send(lvl, arguments); };
            });
            window.addEventListener('error', function (e) {
              send('error', ['[onerror] ' + (e.message || '') + ' @ ' + (e.filename || '') + ':' + (e.lineno || '')]);
            });
            window.addEventListener('unhandledrejection', function (e) {
              send('error', ['[unhandledrejection] ' + ser(e.reason)]);
            });
            console.info('[remote-log] device console piped to dev terminal');
          })();`}
        </script>
      )
    }
    <meta name="theme-color" content="#000000" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lumen Apeiron" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta
      property="og:image:alt"
      content="A multicolored IFS fractal flame rendered in real time by Lumen Apeiron"
    />
    <meta property="og:url" content={canonical} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <Nav />
    <slot />
    <Footer />

    {/* Tells visitors on a non-WebGPU browser why the flames are static. Renders
        only when live previews can't run; client-only (reads navigator.gpu). */}
    <PreviewModeNotice client:only="solid-js" />

    <button id="to-top" class="to-top" type="button" aria-label="Scroll to top">
      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M12 19V5M5 12l7-7 7 7"></path>
      </svg>
    </button>

    <script>
      // Phone-only "scroll to top": reveal once past the first viewport, smooth
      // (or instant under reduced-motion) scroll home on tap. CSS hides it above
      // the phone breakpoint, so the listener is cheap and harmless on desktop.
      const toTop = document.getElementById('to-top')
      if (toTop) {
        const onScroll = () => {
          toTop.classList.toggle(
            'visible',
            window.scrollY > window.innerHeight * 0.6,
          )
        }
        window.addEventListener('scroll', onScroll, { passive: true })
        onScroll()
        toTop.addEventListener('click', () => {
          const reduce = window.matchMedia(
            '(prefers-reduced-motion: reduce)',
          ).matches
          window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' })
        })
      }
    </script>

    <script>
      // Reveal each section as it scrolls into view (one-shot).
      const obs = new IntersectionObserver(
        (entries, io) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-revealed')
              io.unobserve(e.target)
            }
          }
        },
        { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
      )
      document
        .querySelectorAll('main > section')
        .forEach((s) => obs.observe(s))
    </script>
    <script>
      // Track CTA clicks through to the app. Match the app origin's hostname
      // exactly AND require the site root — a substring test also matches this
      // site's own links (relative hrefs like "#features" resolve to
      // about.lumenapeiron.com), and the Discord invite is served by the app
      // Worker at lumenapeiron.com/discord, so hostname alone would count
      // "Join the Discord" as a launch-app conversion.
      document.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement)?.closest('a')
        if (!link || !link.href) return
        let event: 'click_launch_app' | 'click_launch_arcade'
        try {
          const url = new URL(link.href)
          if (url.hostname !== 'lumenapeiron.com') return
          if (url.pathname === '/' || url.pathname === '') {
            event = 'click_launch_app'
          } else if (url.pathname === '/arcade' || url.pathname === '/arcade/') {
            event = 'click_launch_arcade'
          } else {
            return
          }
        } catch {
          return
        }
        if (typeof window.gtag === 'function') {
          window.gtag('event', event, {
            link_url: link.href,
            link_text: link.textContent?.trim() || '',
          })
        }
      })
    </script>
  </body>
</html>
