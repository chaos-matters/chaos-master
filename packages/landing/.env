# Pipe device console logs to the dev-server terminal (dev only). Off by default.
# Override locally in .env.local (gitignored) — e.g. PUBLIC_REMOTE_LOG=true — to
# debug phones/tablets that have no usable console. See remoteLogPlugin in
# astro.config.mjs + the interceptor in src/layouts/Base.astro.
PUBLIC_REMOTE_LOG=false

# Google Analytics 4 Property Measurement ID (e.g. G-XXXXXXXXXX)
PUBLIC_GA_ID=G-0NTY367X2S

# The landing bundles the app's Flam3 renderer, whose defaults read VITE_* here.

# Match the app's chain re-seed cadence (the app sets this to 1; unset it defaults
# to 32). 1 = re-warm every dispatch → less post-camera-move settle flicker during
# pan / orbit / animate.
VITE_PERSIST_RESEED_INTERVAL=1
