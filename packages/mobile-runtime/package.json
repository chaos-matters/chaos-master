{
  "name": "@chaos-master/mobile-runtime",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Native capabilities for the Lumen Apeiron web app, loaded only by its native (Capacitor) build",
  "exports": {
    "./files": {
      "types": "./src/files.ts",
      "import": "./src/files.ts",
      "default": "./src/files.ts"
    },
    "./capacitor": {
      "types": "./src/capacitor/index.ts",
      "import": "./src/capacitor/index.ts",
      "default": "./src/capacitor/index.ts"
    },
    "./haptics": {
      "types": "./src/haptics.ts",
      "import": "./src/haptics.ts",
      "default": "./src/haptics.ts"
    },
    "./capacitor-haptics": {
      "types": "./src/capacitor/haptics.ts",
      "import": "./src/capacitor/haptics.ts",
      "default": "./src/capacitor/haptics.ts"
    },
    "./lifecycle": {
      "types": "./src/lifecycle.ts",
      "import": "./src/lifecycle.ts",
      "default": "./src/lifecycle.ts"
    },
    "./capacitor-lifecycle": {
      "types": "./src/capacitor/lifecycle.ts",
      "import": "./src/capacitor/lifecycle.ts",
      "default": "./src/capacitor/lifecycle.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
