# Native (Capacitor) build: `vite build --mode native` (pnpm build:native)
# layers this over .env. No secrets: everything here ships inside the app.

# The bundle is served from capacitor://localhost (iOS) and https://localhost
# (Android), so API calls and share links need absolute origins.
VITE_API_ORIGIN=https://lumenapeiron.com
VITE_PUBLIC_ORIGIN=https://lumenapeiron.com

# No analytics in native v1 (App Store privacy label: data not collected).
VITE_GA_ID=

# Discord share, the only Turnstile user, is hidden in native.
VITE_TURNSTILE_SITE_KEY=

# Phones and tablets share GPU memory with the OS: one concurrent preview
# render instead of two.
VITE_COMPUTE_GATE_CAPACITY=1
