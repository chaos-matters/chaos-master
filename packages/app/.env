# duplicate this file and call it '.env.local' to override defaults
VITE_DEFAULT_POINT_COUNT=1e6
# Points each chaos-game chain plots after its warmup (throughput vs per-dispatch cost)
VITE_PLOTS_PER_CHAIN=16
# Dispatches a persisted chain runs before re-seeding + re-warming. Lower = warmup/
# skipIters reads more strongly + less settle flicker, at a throughput cost
# (1 = re-warm every dispatch / no persistence); higher = max throughput.
VITE_PERSIST_RESEED_INTERVAL=1
VITE_DEFAULT_RENDER_INTERVAL_MS=1
VITE_DEFAULT_RESOLUTION=1
VITE_DEFAULT_ZOOM_LEVEL=1
VITE_DEFAULT_QUALITY=0.95
VITE_DEFAULT_HIGH_QUALITY=0.95
VITE_DEFAULT_ULTRA_QUALITY=0.995
VITE_DEFAULT_VARIATION_SHOW_DELAY_MS=50
VITE_DEFAULT_PREVIEW_PIXEL_RATIO=1
VITE_DEFAULT_VARIATION_PREVIEW_QUALITY=0.95
VITE_DEFAULT_VARIATION_PREVIEW_POINT_COUNT=1e5
VITE_DEFAULT_VARIATION_PREVIEW_RENDER_INTERVAL_MS=10
VITE_STATIC_PREVIEW_POINT_COUNT=1e5
VITE_ANIMATION_PREVIEW_QUALITY=0.995
VITE_ANIMATION_PREVIEW_POINT_COUNT=1e5
VITE_THUMBNAIL_PREVIEW_QUALITY=0.95
VITE_THUMBNAIL_PREVIEW_QUALITY_HOVER=0.999
VITE_COMPUTE_GATE_CAPACITY=2

# Animation frame preview quality presets (for animation export gallery thumbnails)
VITE_ANIMATION_FRAME_PREVIEW_QUALITY_LOW=0.97
VITE_ANIMATION_FRAME_PREVIEW_QUALITY_MID=0.98
VITE_ANIMATION_FRAME_PREVIEW_QUALITY_HIGH=0.99

# Set to 'true' to force show welcome screen on startup (useful for development)
# Defaults to showing welcome screen on first visit when not set
VITE_SHOW_WELCOME_ON_STARTUP=false

# Set to 'true' (in .env.local) to skip the welcome screen entirely on startup,
# which also skips the on-startup hardware-tier detection (it lives inside the
# welcome screen) and falls back to the 'high' tier. Handy for local dev and for
# driving the app with Playwright/agents. Leave false for normal builds.
VITE_SKIP_WELCOME=false
VITE_CANVAS_RESIZE_DEBOUNCE_MS=200

# Default for the "camera control during render" toggle in the animation
# render dialog. When on, camera pan/scroll/zoom stays active during animation
# export and gets baked into the rendered video (creative live-control mode).
VITE_ALLOW_CAMERA_DURING_EXPORT=false

# Cloudflare Turnstile site key for the "Share to Discord" bot check. Public by
# design (it ships in the bundle). Leave blank to disable the widget locally —
# the Worker only enforces verification when its TURNSTILE_SECRET is set, so the
# two stay in step. For local enforcement use Cloudflare's "always passes" test
# key 1x00000000000000000000AA (secret 1x0000000000000000000000000000000AA).
VITE_TURNSTILE_SITE_KEY=0x4AAAAAADoNlUQIGinFGTZv

# Debug options (enable if you know what you are doing!)
VITE_DEBUG_VRAM=false
VITE_DEBUG_MODE=false
