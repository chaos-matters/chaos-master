{
  "name": "chaos-master",
  "version": "0.9.10",
  "description": "WebGPU based IFS Flame Generator for Artists & Explorers",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "capture:readme": "node scripts/capture-readme-screenshots.mjs",
    "flam3:compat": "node scripts/flam3-compat.mjs",
    "serve": "vite preview",
    "prod": "vite build && vite preview",
    "e2e:serve": "VITE_GA_ID= vite build && vite preview --port 4173 --strictPort",
    "start": "vite",
    "test": "vitest",
    "test:scripts": "node --test scripts/gallery-poster-manifest.test.mjs",
    "analyze-bundle": "VITE_ANALYZE_BUNDLE=true vite build",
    "deploy:dev": "pnpm run build:dev && pnpm exec wrangler deploy --env dev",
    "deploy:prod": "pnpm run build && pnpm exec wrangler deploy --env prod",
    "wr-dev": "pnpm exec wrangler dev --env dev",
    "r2:create:dev": "pnpm exec wrangler r2 bucket create chaos-master-og-images-dev",
    "r2:create:prod": "pnpm exec wrangler r2 bucket create chaos-master-og-images"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@solid-primitives/upload": "^0.1.4",
    "@typegpu/color": "0.12.0",
    "@typegpu/noise": "0.12.0",
    "@typegpu/sdf": "0.12.0",
    "@vercel/analytics": "1.6.1",
    "acorn": "^8.16.0",
    "dexie": "^4.4.2",
    "dompurify": "^3.4.11",
    "fflate": "^0.8.3",
    "marked": "^18.0.4",
    "mathjax": "^4.1.2",
    "mp4-muxer": "^5.2.2",
    "solid-devtools": "^0.34.5",
    "solid-js": "1.9.11",
    "structurajs": "0.12.6",
    "tinyest-for-wgsl": "^0.4.0",
    "typegpu": "0.12.0",
    "valibot": "1.2.0",
    "wgpu-matrix": "3.4.2"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.19.1",
    "@codemirror/lint": "^6.8.6",
    "@codemirror/search": "^6.5.11",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-solid": "^0.14.5",
    "fake-indexeddb": "^6.2.5",
    "vite-plugin-qrcode": "^0.4.1",
    "wrangler": "^4.103.0"
  }
}
